{
    "selector": "source.cs | source.cake",

    // Plugin-specific settings (used by LSP-Roslyn itself)
    "settings": {
        "roslyn.defaultLaunchSolution": null,
        "roslyn.loggingLevel": "Information",
        "roslyn.debug": false,
        "roslyn.forceProjectOpen": false
    },

    // Roslyn language server options (sent via workspace/configuration)
    // Structure: roslyn.{group}.{option_name}
    "roslyn": {
        "projects": {
            // Set to a folder path to enable binlogs; keep null to disable.
            "dotnet_binary_log_path": null,
            "dotnet_enable_automatic_restore": true,
            "dotnet_enable_file_based_programs": true,
            "dotnet_enable_file_based_programs_when_ambiguous": true
        },

        "background_analysis": {
            "dotnet_analyzer_diagnostics_scope": "default",
            "dotnet_compiler_diagnostics_scope": "openFiles"
        },

        "code_lens": {
            "dotnet_enable_references_code_lens": true,
            "dotnet_enable_tests_code_lens": true
        },

        "formatting": {
            "dotnet_organize_imports_on_format": false
        },

        "completion": {
            "dotnet_show_name_completion_suggestions": true,
            "dotnet_show_completion_items_from_unimported_namespaces": null,
            "dotnet_trigger_completion_in_argument_lists": true,
            "dotnet_provide_regex_completions": true
        },

        "inlay_hints": {
            "dotnet_enable_inlay_hints_for_parameters": false,
            "csharp_enable_inlay_hints_for_types": false
        },

        "navigation": {
            "dotnet_navigate_to_decompiled_sources": true,
            "dotnet_navigate_to_source_link_and_embedded_sources": true
        },

        "symbol_search": {
            "dotnet_search_reference_assemblies": true
        },

        "quick_info": {
            "dotnet_show_remarks_in_quick_info": true
        },

        "highlighting": {
            "dotnet_highlight_related_regex_components": true,
            "dotnet_highlight_related_json_components": true
        },

        "auto_insert": {
            "dotnet_enable_auto_insert": true
        }
    }
}
